{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Cors": {
        "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173" ]
    },
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5433;Database=vesty;Username=vesty;Password=vesty;"
    },
    "JwtSettings": {
        "validIssuer": "VestyAPI",
        "validAudience": "https://localhost:5001",
        "expires": 60,
        "secretKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
    },
    "Storage": {
        "Endpoint": "localhost:9000",
        "AccessKey": "vesty",
        "SecretKey": "vestyvesty",
        "Bucket": "vesty-attachments",
        "UseSsl": false
    },
    "MessageEncryption": {
        "Key": "REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY"
    }
}
